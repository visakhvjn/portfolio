# Contact form — emails are delivered to vjnvisakh@gmail.com (see src/data/site.ts)
#
# Option A (recommended): Resend — https://resend.com
# 1. Create an API key
# 2. On the free tier, use onboarding@resend.dev as the sender until you verify a domain
# 3. Add the key in Vercel → Settings → Environment Variables (and locally in .env.local)

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to Portfolio Contact <onboarding@resend.dev>
# RESEND_FROM=Portfolio <contact@yourdomain.com>

# Option B: Web3Forms — https://web3forms.com (register with vjnvisakh@gmail.com)
# WEB3FORMS_ACCESS_KEY=your-access-key
