# Playground Supabase — two projects (see supabase/README.md)
#
# MCQ Quiz → supabase/mcq-quiz/migrations/
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-mcq-anon-key
# Auth: enable Google; redirect http://localhost:3000/auth/callback
#
# Dynamic QR → supabase/dynamic-qr/migrations/
NEXT_PUBLIC_DYNAMIC_QR_SUPABASE_URL=https://yyyy.supabase.co
NEXT_PUBLIC_DYNAMIC_QR_SUPABASE_ANON_KEY=your-dynamic-qr-anon-key
# Optional (server-only): bypass RLS for /r/[slug] redirects if anon policies misbehave
# DYNAMIC_QR_SUPABASE_SERVICE_ROLE_KEY=your-dynamic-qr-service-role-key
# Auth: enable Google; redirect http://localhost:3000/auth/callback/dynamic-qr
#
# MCQ parsing uses the visitor's OpenAI key in the browser (BYO key).
